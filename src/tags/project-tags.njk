---
pagination:
  data: collections
  size: 1
  alias: tag
permalink: /project-tags/{{ tag }}/
layout: base.njk
renderData:
  title: "Progetti con tag “{{ tag }}”"
  metaDescription: "Tutti i progetti con il tag “{{ tag }}”"
---
<div class="page-container">
  {# Header #}
  <div class="tag-list tag-list--no-wrap">
    <h4 class="tag-list__title">Progetti con tag: "{{ tag | capitalize }}"</h4>
    <a class="btn btn--sm btn--danger" href="{{ '/projects' | url }}">Rimuovi tag</a>
  </div>

  {# Projects #}
  {% from "macros/projectlist.njk" import projectlist %}
  {{ projectlist(projects = collections[tag] | reverse) }}

  {# Footer #}
  <nav>
    <a href="{{ '/projects/' | url }}">← Vedi tutti i progetti</a>
  </nav>
</div>
